###############################################################################
# Lab Template - Environment Variables
#
# Copy this file to ".env" for local development.
#
# For GitHub Actions, add the same values as Repository Secrets instead:
# Settings → Secrets and variables → Actions
#
# Do not commit your completed ".env" file.
###############################################################################


###############################################################################
# Data access
###############################################################################

# Synapse authentication
SYNAPSE_AUTH_TOKEN=XXXX

# Box authentication
BOX_CLIENT_ID=XXXX
BOX_CLIENT_SECRET=XXXX


###############################################################################
# Optional service credentials
###############################################################################

# Add credentials for any additional services used by this workflow.
#
# EXAMPLE_SERVICE_URL=https://example.org
# EXAMPLE_SERVICE_USERNAME=your_username
# EXAMPLE_SERVICE_TOKEN=your_access_token
# EXAMPLE_SERVICE_PROJECT=my_project
