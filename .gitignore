################################################################################
# USER PROJECT-SPECIFIC IGNORES
#
# Add project-dependent files and folders here.
# Keep general rules elsewhere.
################################################################################


################################################################################
# Data lifecycle policy
#
# Edit this section for project data organisation.
################################################################################

# Data
data/*
!data/**/
!data/**/README.md
!data/provenance/**

# Runtime and pipeline outputs
logs/*
!logs/external/

results/*
!results/**/
!results/**/README.md

work/*
!work/**/
!work/**/README.md

# Exploratory outputs (keep README tracked)
exploratory/*
!exploratory/README.md

# Temporary folders
tmp/
temp/

################################################################################
# Local configuration
################################################################################

.env
.env.*
*.secret
*.credentials
config.local.*


################################################################################
# OS / system files
################################################################################

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

*~
*.swp
*.swo


################################################################################
# Archives
# Ignore archive formats, but keep standalone compressed data files (.gz)
################################################################################

*.tar
*.tar.gz
*.zip
*.bz2
*.xz
*.7z
*.rar
*.Z


